rules_version = '2';

// Deny by default. Every collection below is opened deliberately.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Roles come ONLY from custom claims set by the Admin SDK, never from client data.
    function role() { return signedIn() ? request.auth.token.role : null; }
    function isStaff() { return role() in ['manager', 'admin']; }
    function isAdmin() { return role() == 'admin'; }

    // Public catalogue: anyone can read active products and categories. Writes are staff-only.
    match /products/{productId} {
      allow read: if resource.data.status == 'active' || isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.isActive == true || isStaff();
      allow write: if isStaff();
    }

    match /collections/{collectionId} {
      allow read: if resource.data.isActive == true || isStaff();
      allow write: if isStaff();
    }

    // Customer profile: owner or staff. Role is never writable by the client.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn() && request.auth.uid == uid && !('role' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
                    && !('role' in request.resource.data);
      allow delete: if false;
    }

    // Cart and wishlist: owner only. Prices are re-validated server-side at checkout.
    match /carts/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /wishlists/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Orders: owner reads their own. Creation and status changes go through trusted server routes.
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create, update, delete: if false;
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
