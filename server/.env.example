# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Firebase Admin Configuration
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Base64 or stringified JSON in environment variable
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Option C: Direct Firebase Project ID (if running on Google Cloud Run / Functions)
# FIREBASE_PROJECT_ID=aurelle-jewels

# Email Configuration (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Aurelle Jewels Atelier <orders@aurellejewels.com>"
STORE_NOTIFICATION_EMAIL=orders@aurellejewels.com

# Payment Gateway / Webhook Secret (for JazzCash, Easypaisa, Safepay or aggregator)
PAYMENT_WEBHOOK_SECRET=aurelle_secret_webhook_key_2026

# Store Policy Defaults
FREE_SHIPPING_THRESHOLD=5000
STANDARD_SHIPPING_FEE=250
PREPAID_DISCOUNT_PERCENT=5

